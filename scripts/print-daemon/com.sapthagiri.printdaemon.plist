<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd unit for macOS — auto-start the print daemon at boot, restart on crash.

  Setup:
    1. Edit the two paths below (REPO_PATH) to your checkout, e.g.
       /Users/sree/sapthagiri-dosa
    2. cp this file to ~/Library/LaunchAgents/com.sapthagiri.printdaemon.plist
    3. launchctl load -w ~/Library/LaunchAgents/com.sapthagiri.printdaemon.plist
    4. Logs: tail -f /tmp/sapthagiri-printdaemon.log
  Stop:  launchctl unload ~/Library/LaunchAgents/com.sapthagiri.printdaemon.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sapthagiri.printdaemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>npm</string>
    <string>run</string>
    <string>daemon</string>
  </array>

  <!-- ⬇ change to your repo checkout path -->
  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/sapthagiri-printdaemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sapthagiri-printdaemon.log</string>
</dict>
</plist>
