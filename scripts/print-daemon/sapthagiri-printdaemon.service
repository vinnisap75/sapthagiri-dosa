# systemd unit for Linux / Raspberry Pi — auto-start at boot, restart on crash.
#
# Setup:
#   1. Edit User= and WorkingDirectory= below for your box + checkout path.
#   2. sudo cp sapthagiri-printdaemon.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now sapthagiri-printdaemon
#   5. Logs: journalctl -u sapthagiri-printdaemon -f

[Unit]
Description=Sapthagiri kitchen print daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sapthagiri-dosa
ExecStart=/usr/bin/npm run daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
