# Copy this file to  printer.env  (same folder) on the LAN box and fill it in.
# printer.env is gitignored — the service-role key is a SECRET, keep it here only.

# Supabase: Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# ⚠ SERVICE ROLE key (NOT the anon key). Full backend access — never put this in
#   the web app, the browser, or git. It lives only on this machine.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Kitchen printer (Star SP742)
PRINTER_HOST=10.1.10.200
PRINTER_PORT=9100
PRINTER_MODE=starline

# Optional tuning
POLL_MS=2000
LOOKBACK_HOURS=6
