# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API → Legacy
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# OPTIONAL but recommended: set this to your stable hosted URL (e.g. Vercel).
# When set, /admin/qrs encodes this URL into every QR code, so the printed
# sheet keeps working whether you generate it from localhost or production.
# NEXT_PUBLIC_PUBLIC_URL=https://sapthagiri-dosa.vercel.app
